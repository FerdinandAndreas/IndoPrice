# Untuk API key gemini nya sudah saya cantumkan di file pdf pengumpulan pak, 
# Soalnya kalau saya langsung cantumkan di .env github otomatis akan mendeteksi sebagai sensitive data dan dihapus, jadi saya cantumkan di file pdf saja pak.

# Django Security Key
SECRET_KEY=django-insecure-indopriceai-sistem-cerdas-p14-secret-key-2024
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Google Gemini API Key 
# Jika dikosongkan sistem akan otomatis menggunakan analisis cadangan berbasis data nyata (Rule-Based Fallback)
GEMINI_API_KEY=
